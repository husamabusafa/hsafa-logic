{
  "name": "@hsafa/cli",
  "version": "7.0.1",
  "description": "Hsafa CLI (v7) — scaffold custom skills, manage skill instances, and connect them to haseefs",
  "type": "module",
  "bin": {
    "hsafa": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/prompts": "^2.4.9",
    "typescript": "^5"
  },
  "keywords": [
    "hsafa",
    "cli",
    "skills",
    "haseef"
  ],
  "license": "MIT"
}
